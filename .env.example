# ─── Database ────────────────────────────────────────────────────────────────
# "neon" uses the Neon serverless driver (recommended on Vercel).
# "pg" uses node-postgres – use for local Postgres, AWS RDS / Aurora.
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ehs
# Optional pool tuning. Leave unset for Neon / RDS unless you need to cap connections.
# With the local `prisma dev` database use DATABASE_POOL_MAX=10 and DATABASE_IDLE_TIMEOUT_MS=1
# (it drops idle connections, so they must not be reused).
# DATABASE_POOL_MAX=
# DATABASE_IDLE_TIMEOUT_MS=
# Non-pooled URL used by `prisma migrate` (Neon: the direct connection string).
# DIRECT_URL=

# ─── File storage ────────────────────────────────────────────────────────────
# "local"        – files stored on this machine (LOCAL_STORAGE_DIR). For local testing only.
# "vercel-blob"  – Vercel Blob (needs BLOB_READ_WRITE_TOKEN).
# "s3"           – AWS S3 or any S3-compatible store.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# BLOB_READ_WRITE_TOKEN=
# S3_BUCKET=
# S3_REGION=eu-west-1
# S3_ENDPOINT=              # optional, for S3-compatible stores (MinIO, R2…)
# S3_ACCESS_KEY_ID=         # optional – falls back to the default AWS credential chain
# S3_SECRET_ACCESS_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ─── Security / jobs ─────────────────────────────────────────────────────────
# Signs acknowledgement + audit records (HMAC). Defaults to BETTER_AUTH_SECRET.
# AUDIT_SIGNING_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/settings/keys) for the help chatbot (✦ button, bottom right).
# Server-only: never sent to the browser, stored in the database or logged. Leave empty and the assistant
# shows "not set up yet" to administrators and stays hidden for everyone else. Model and guide text are
# set per company in Configuration → AI assistant (default model: openrouter/free).
# OPENROUTER_API_KEY=
